---
import '../styles/global.css';
import { ThemeProvider } from '../components/ThemeProvider';
import { Dock } from '../components/features/dock/Dock';
import { TooltipProvider } from '../components/ui/tooltip';
import SeoHead from '../components/SeoHead.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
}

const { title, description, canonical, ogImage, ogImageAlt } = Astro.props;
---

<html lang="fr">
<head>
    <SeoHead
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      ogImageAlt={ogImageAlt}
    />
</head>
<body class="flex flex-col min-h-screen bg-background text-foreground">
<main class="flex-1 pb-16">
    <ThemeProvider client:load>
        <TooltipProvider>
            <slot />
        </TooltipProvider>
    </ThemeProvider>
</main>
<Dock client:load />
</body>
</html>
